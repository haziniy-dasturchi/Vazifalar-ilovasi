<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Firebase bildirishnomalari uchun standart ko'rinish: ilova fonda
          bo'lganda xabarni Android'ning o'zi chizadi va shu qiymatlarni
          oladi. Ularsiz ikonka oq kvadrat, kanal esa "fcm_fallback"
          (o'rtacha muhimlik — ekran tepasida chiqmaydi) bo'lardi.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_samara" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/bildirishnoma_rangi" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/bildirishnoma_kanali" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 13+ (API 33) da bildirishnoma ko'rsatish uchun alohida
      ruxsat so'raladi. `@capacitor/push-notifications` plagini uni
      Java kodida so'raydi, lekin O'Z manifestida e'lon QILMAYDI —
      shuning uchun bu yerda bo'lmasa, ruxsat oynasi umuman
      chiqmaydi va bildirishnoma jimgina kelmay qo'yadi.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Topshiriq chatidagi ovozli xabar: WebView mikrofon so'raganda Capacitor shu ruxsatni beradi -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
