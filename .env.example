# =============================================================
# Samara — muhit o'zgaruvchilari namunasi
# =============================================================
# Bu faylni .env.local ga nusxalab, qiymatlarni to'ldiring.
# .env.local hech qachon git ga tushmasligi kerak.

# -------------------------------------------------------------
# Frontend (keyingi bosqich — Next.js)
# -------------------------------------------------------------
# Supabase loyihasi: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Lokal ishlaganda (supabase start) qiymatlar quyidagicha bo'ladi —
# aniq anon key ni `supabase status` buyrug'i ko'rsatadi:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status chiqargan anon key>

# -------------------------------------------------------------
# Google OAuth (supabase/config.toml shu o'zgaruvchilarni o'qiydi)
# -------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
SUPABASE_AUTH_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------
# Native Google kirish (Capacitor — Android/iOS)
# -------------------------------------------------------------
# Mijoz ID — maxfiy EMAS (parol emas, shunchaki identifikator), shuning
# uchun NEXT_PUBLIC_. Qiymati yuqoridagi SUPABASE_AUTH_GOOGLE_CLIENT_ID
# bilan BIR XIL bo'lishi SHART — aks holda signInWithIdToken token'ni
# rad etadi ("audience" mos kelmaydi).
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# iOS uchun alohida OAuth mijoz — Apple Developer hisobi sozlanmaguncha
# bo'sh qoling, Android build'iga ta'sir qilmaydi
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# -------------------------------------------------------------
# Xayriya to'lovlari ("Loyihani qo'llab-quvvatlash")
# -------------------------------------------------------------
# Bo'sh qolgan tizimning tugmasi ko'rinmaydi. Ikkalasi bo'sh
# bo'lsa — to'lov bo'limi umuman chiqmaydi.
#
# Payme Business kabinetidagi kassa ID'si (maxfiy emas).
# Kassa sozlamasida hisob maydoni nomi: xayriya_id
NEXT_PUBLIC_PAYME_MERCHANT_ID=
# 1 — test kassasi (checkout.test.paycom.uz)
NEXT_PUBLIC_PAYME_TEST=
# Click kabinetidagi xizmat va merchant ID'lari (maxfiy emas)
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
#
# Maxfiy kalitlar bu yerda EMAS — Supabase Edge funksiyalarida:
#   supabase secrets set PAYME_KEY=... PAYME_TEST_KEY=...
#   supabase secrets set CLICK_SERVICE_ID=... CLICK_SECRET_KEY=...
