# =============================================================
# Vazifalar — muhit o'zgaruvchilari namunasi
# =============================================================
# Bu faylni .env.local ga nusxalab, qiymatlarni to'ldiring.
# .env.local hech qachon git ga tushmasligi kerak.

# -------------------------------------------------------------
# Frontend (keyingi bosqich — Next.js)
# -------------------------------------------------------------
# Supabase loyihasi: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Lokal ishlaganda (supabase start) qiymatlar quyidagicha bo'ladi —
# aniq anon key ni `supabase status` buyrug'i ko'rsatadi:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status chiqargan anon key>

# -------------------------------------------------------------
# Google OAuth (supabase/config.toml shu o'zgaruvchilarni o'qiydi)
# -------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
SUPABASE_AUTH_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
SUPABASE_AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
